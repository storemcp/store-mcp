<?xml version="1.0"?>
<ruleset name="StoreMCP">
	<description>Coding standards for the StoreMCP plugin.</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/screenshots-src/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<!-- Scan only PHP -->
	<arg name="extensions" value="php"/>

	<!-- Show progress and colours -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Use WordPress standards -->
	<rule ref="WordPress">
		<!-- Filename rule fights our class-*.php convention in an explicit way;
		     keep it for consistency with wordpress.org guidelines. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- Minimum PHP version supported by the plugin -->
	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<!-- i18n text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="store-mcp"/>
			</property>
		</properties>
	</rule>

	<!-- Prefix for globals -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="store_mcp"/>
				<element value="storemcp"/>
				<element value="STORE_MCP"/>
				<element value="StoreMCP"/>
				<element value="smcp"/>
			</property>
		</properties>
	</rule>
</ruleset>
