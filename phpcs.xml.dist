<?xml version="1.0"?>
<ruleset name="StoreMCP">
	<description>Coding standards for the StoreMCP plugin.</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/screenshots-src/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<!-- Scan only PHP -->
	<arg name="extensions" value="php"/>

	<!-- Show progress and colours -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!--
	  Use the extra-strict WordPress ruleset but opt out of the rules that
	  don't fit a modern, namespaced, PHP 8+ codebase. We keep all the
	  security- and i18n-relevant sniffs.
	-->
	<rule ref="WordPress-Extra">
		<!-- Short array syntax: we require PHP 8.0+ so [] is fine. -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

		<!-- Filename rule fights our class-*.php / trait-*.php convention. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>

		<!-- Doc-comment-required sniffs: we document public API but not
		     every private helper. Keeping these as errors produces hundreds
		     of low-signal warnings. -->
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.InlineComment.NoSpaceBefore"/>
		<exclude name="Squiz.Commenting.BlockComment.NoNewLine"/>

		<!-- Alignment sniffs: useful in some codebases, mechanically noisy
		     across a large plugin that already has consistent internal style. -->
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>

		<!-- Multi-line function call formatting: fights legible inline arrays. -->
		<exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.OnlyOneArgumentPerLine"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.EmptyLine"/>

		<!-- Yoda conditions are optional — leave as warnings, not errors. -->
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
	</rule>

	<!-- Keep nonce verification as a warning, not a blocking error.
	     PHPCS cannot trace nonces across WP's ajax dispatcher + our helpers,
	     which produces noisy false positives. Real nonce checks live in
	     Admin_Ajax::verify_request() and every handler calls it. -->
	<rule ref="WordPress.Security.NonceVerification">
		<type>warning</type>
	</rule>

	<!-- Minimum PHP version supported by the plugin -->
	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<!-- i18n text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="store-mcp"/>
			</property>
		</properties>
	</rule>

	<!-- Prefix for globals -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="store_mcp"/>
				<element value="storemcp"/>
				<element value="STORE_MCP"/>
				<element value="StoreMCP"/>
				<element value="smcp"/>
			</property>
		</properties>
	</rule>

	<!--
	  Fail the build on errors, but allow warnings. Use `phpcs -n` locally
	  if you want to ignore warnings entirely while iterating.
	-->
	<arg name="warning-severity" value="0"/>
</ruleset>
